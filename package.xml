<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sapphire_ros2</name>
  <version>0.1.0</version>
  <description>Sapphire SLAM — ROS 2 wrapper</description>
  <maintainer email="bindeer@users.noreply.github.com">bindeer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_ros</depend>
  <depend>eigen3_cmake_module</depend>

  <!-- PCL and Eigen resolved by rosdep via pcl_ros + eigen3_cmake_module + system deps -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
